# ─────────────────────────────────────────────────────────────────────────────
# VOICE AGENT — Environment Variables Template
# Copy this file to ".env" and fill in your real values.
# The actual ".env" is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq (required for Phase 1+) ─────────────────────────────────────────────
# Free at: https://console.groq.com  (no credit card needed)
# Used for both Speech-to-Text (Whisper) and the LLM (Llama).
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY

# ── Twilio (required for Phase 3 — real phone calls) ─────────────────────────
# Free trial at: https://www.twilio.com/try-twilio
# Find SID + Token at: https://console.twilio.com → Dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# The phone number Twilio gave you (E.164 format, e.g. +14155552671)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── ElevenLabs (optional — Phase 2+ demo voice swap) ─────────────────────────
# Free tier: 10,000 characters/month at: https://elevenlabs.io
# Leave blank to use Piper (local, offline, unlimited) instead.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — no setup needed, file created automatically):
DATABASE_URL=sqlite:///agent_calls.db

# Supabase Postgres (Phase 4 upgrade — get from your Supabase project settings):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOURPROJECT.supabase.co:5432/postgres

# ── Agent behaviour (optional overrides) ─────────────────────────────────────
# Which TTS engine to use: "system" (default, zero setup), "piper" (better quality), or "elevenlabs" (best)
TTS_ENGINE=system

# Piper voice model name (only used when TTS_ENGINE=piper)
# Run: python scripts/download_piper_voice.py  to download the model file
# Browse voices: https://huggingface.co/rhasspy/piper-voices/tree/main
PIPER_VOICE=en_US-amy-medium

# Groq model for the LLM reasoning step.
# Check current free models at: https://console.groq.com/docs/models
LLM_MODEL=qwen/qwen3.8-27b

# Groq model for Speech-to-Text.
STT_MODEL=whisper-large-v3-turbo

# Set to "true" to print every LLM prompt/response to the console (debug mode).
DEBUG_LLM=false
